IS_PUBLIC_URL=https://substrate.company.example
IS_BOOTSTRAP_EMAIL=admin@company.example
IS_BOOTSTRAP_SECRET_PATH=./.secrets/bootstrap-password
# Generate a URL-safe password, for example with openssl rand -hex 24.
IS_POSTGRES_PASSWORD=replace-before-starting
IS_HTTP_PORT=8080

# Standalone binary only: optional administrator-installed blueprint release root.
# Default '-' disables it; the bundled Docker image uses /app.
# IS_BLUEPRINT_ROOT=/opt/intelligence-substrate

# Optional governed Web previews; enable deploy/compose.preview.yaml separately.
# Native process: set an explicit host:port in IS_PREVIEW_LISTEN as well.
# Production needs HTTPS and a hostname different from IS_PUBLIC_URL.
IS_PREVIEW_LISTEN=
IS_PREVIEW_URL=
IS_PREVIEW_HTTP_PORT=8083
# Separate fullstack preview node; never mount Docker in the control plane.
# Native setting; Compose needs an explicit operator-managed socket mount.
IS_PREVIEW_NODE_SOCKET=

# Optional operator-selected images, including enterprise mirrors/digest pins.
# Defaults remain the upstream images in compose.yaml / Dockerfile.
IS_PLATFORM_IMAGE=intelligence-substrate:local
IS_POSTGRES_IMAGE=postgres:17-alpine
IS_NODE_IMAGE=node:22-alpine
IS_GO_IMAGE=golang:1.27.3-alpine
IS_RUNTIME_IMAGE=debian:trixie-slim
# Non-secret dependency mirror URLs; go.sum/npm integrity checks stay enabled.
IS_BUILD_GOPROXY=https://proxy.golang.org,direct
IS_BUILD_NPM_REGISTRY=https://registry.npmjs.org

# Optional OpenAI-compatible model gateway. Both prices must be explicit.
IS_MODEL_BASE_URL=
IS_MODEL_NAME=
# Absolute 0600 file containing the key; the legacy inline variable is kept for compatibility only.
IS_MODEL_API_KEY_FILE=
IS_MODEL_API_KEY=
IS_MODEL_INPUT_USD_PER_MILLION=
IS_MODEL_OUTPUT_USD_PER_MILLION=
IS_MODEL_EXTERNAL=true
IS_MODEL_ALLOW_HTTP=false
# Optional persistent spacing across instances using the same platform database.
# Set according to the provider's quota; failed external calls are never replayed.
IS_MODEL_MIN_INTERVAL_SECONDS=0
# Default output cap for planning and Agent calls, including provider reasoning (1-8192)
IS_MODEL_DEFAULT_MAX_TOKENS=4096
# Optional provider-supported thinking/reasoning_effort only; never credentials
IS_MODEL_OPTIONS_JSON=

# Optional OIDC. Create the enterprise member before allowing SSO login.
IS_OIDC_ISSUER=
IS_OIDC_CLIENT_ID=
IS_OIDC_CLIENT_SECRET=

# AX v0.3.1, isolated atespace with no direct model/production credentials.
IS_AX_BINARY=ax
IS_AX_CONTEXT=
IS_AX_NAMESPACE=ax-system
IS_AX_ATESPACE=intelligence-substrate
IS_AX_RUNNER_IMAGE=
# Diagnostic CLI routing only. Production workers use ax.secure in node JSON.
IS_AX_ALLOW_LEGACY_CLI=false
